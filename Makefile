# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2026 AERA | Erez Yaary
# EWeb - a web browser for the Atari Falcon. There is no browser yet: this
# builds the first milestone's tools: nsbench, which parses a saved page
# with NetSurf's HTML parser (Hubbub) and selects every element's style
# with LibCSS and with EWeb's own CSS engine, and ewget, which fetches a
# page with EWeb's HTTP client and times it. See docs/DESIGN.md.
#
#   make             binary/NSBENCH.TTP and binary/EWGET.TTP for the Atari
#                    (plain TOS, any Falcon), with common/'s freestanding
#                    runtime, and the root certificates (CACERT.PEM, ROOTS.DAT)
#   make bench       build/host/nsbench, for this computer
#   make bench68k    build/m68k/nsbench, a Linux 68030 program for counting
#                    instructions under QEMU (tools/count68k.sh)
#   make test        nsbench on the test pages, the Hebrew pages, the CSS
#                    engine's cases, the input stream, the HTTP client and
#                    the fuzz targets' inputs, with AddressSanitizer and UBSan
#   make itest       ewget against servers on this computer (TCP, TLS)
#   make hatarinet   EWGET.TTP in Hatari through FAKESTNG, against them
#   make urltest     the URL parser against the URL Standard's tests
#                    (tests/url/fetch.sh first)
#   make fuzz        the HTTP client and the URL parser under libFuzzer
#   make h5test      Hubbub against the HTML tree-construction tests
#                    (tests/html5lib/fetch.sh first)
#   make dist        a release's files in dist/: NSBENCH.TTP, NSBENCH.TXT,
#                    EWGET.TTP, EWGET.TXT, CACERT.PEM, ROOTS.DAT, SAMPLE.HTM,
#                    NEWS.HTM, NEWS.CSS and EWEB-x.y.zip
#
# Needs: gcc-m68k-linux-gnu, perl, gperf, python3.
#
# NetSurf's libraries are in third_party/netsurf (MIT licence, see each
# COPYING). Their generated sources (character set aliases, HTML entities,
# the element-type hash, LibCSS's property parsers) are made in build/gen,
# so a build changes no tracked file.

# the version: VERSION holds the last release (major.minor) and the build
# never writes it; tools/bump.py starts a release
VERSION_STR := $(shell cat VERSION)

CROSS    ?= m68k-linux-gnu-
HOSTCC   ?= gcc
M68KCC   := $(CROSS)gcc
PERL     ?= perl
GPERF    ?= gperf

NS       := third_party/netsurf
GEN      := build/gen

# ---------------------------------------------------------------- sources

PU_SRC   := $(sort $(shell find $(NS)/libparserutils/src -name '*.c'))
WAP_SRC  := $(NS)/libwapcaplet/src/libwapcaplet.c
HUB_SRC  := $(sort $(shell find $(NS)/libhubbub/src -name '*.c'))
CSS_SRC  := $(sort $(filter-out %/css_property_parser_gen.c,$(shell find $(NS)/libcss/src -name '*.c')))
CSS_PROPS := $(shell sed -n 's/^\([a-z_-][a-z_-]*\):.*/\1/p' $(NS)/libcss/src/parse/properties/properties.gen)
CSS_GENSRC := $(patsubst %,$(GEN)/libcss/autogenerated_%.c,$(CSS_PROPS))
BENCH_SRC := tests/bench/nsbench.c tests/bench/dom.c tests/bench/style.c tests/bench/ecstyle.c \
             tests/bench/plat_posix.c
# EWeb's own CSS engine
EC_SRC   := $(sort $(wildcard src/css/*.c))
EC_FLAGS := -Wall -Wextra -Wno-unused-parameter -Werror -Isrc/css

# what NetSurf's build system defines for its libraries; and no iconv: the
# Atari has none, so every build converts character sets with
# libparserutils' own codecs, the code the Falcon runs
NSDEF    := -D_ALIGNED="__attribute__((aligned))" -D_BSD_SOURCE -D_DEFAULT_SOURCE \
            -DWITHOUT_ICONV_FILTER

# each library sees its own src/ (they share header names such as
# utils/utils.h) and the public headers of all of them
NSINC    := -I$(NS)/libparserutils/include -I$(NS)/libwapcaplet/include \
            -I$(NS)/libhubbub/include -I$(NS)/libcss/include
PU_INC   := -I$(NS)/libparserutils/src -I$(GEN)/libparserutils
HUB_INC  := -I$(NS)/libhubbub/src -I$(GEN)/libhubbub
CSS_INC  := -I$(NS)/libcss/src
WAP_INC  := -I$(NS)/libwapcaplet/src

GENERATED := $(GEN)/libparserutils/aliases.inc $(GEN)/libhubbub/entities.inc \
             $(GEN)/libhubbub/treebuilder/autogenerated-element-type.c $(CSS_GENSRC)

# make keeps them: they are inputs, not leftovers
.SECONDARY: $(CSS_GENSRC)

# ---------------------------------------------------------------- targets

all: binary/NSBENCH.TTP binary/EWGET.TTP binary/ROOTS.DAT

bench: build/host/nsbench build/host/ewget
bench68k: build/m68k/nsbench

.PHONY: all bench bench68k test clean

# ---------------------------------------------------------------- generated sources

$(GEN)/libparserutils/aliases.inc: $(NS)/libparserutils/build/make-aliases.pl $(NS)/libparserutils/build/Aliases
	rm -rf $(GEN)/pu-stage && mkdir -p $(GEN)/pu-stage/build $(GEN)/pu-stage/src/charset $(@D)
	cp $(NS)/libparserutils/build/Aliases $(GEN)/pu-stage/build/
	cd $(GEN)/pu-stage && $(PERL) $(CURDIR)/$(NS)/libparserutils/build/make-aliases.pl >/dev/null
	mv $(GEN)/pu-stage/src/charset/aliases.inc $@ && rm -rf $(GEN)/pu-stage

$(GEN)/libhubbub/entities.inc: $(NS)/libhubbub/build/make-entities.pl $(NS)/libhubbub/build/Entities
	rm -rf $(GEN)/hub-stage && mkdir -p $(GEN)/hub-stage/build $(GEN)/hub-stage/src/tokeniser $(@D)
	cp $(NS)/libhubbub/build/Entities $(GEN)/hub-stage/build/
	cd $(GEN)/hub-stage && $(PERL) $(CURDIR)/$(NS)/libhubbub/build/make-entities.pl >/dev/null
	mv $(GEN)/hub-stage/src/tokeniser/entities.inc $@ && rm -rf $(GEN)/hub-stage

$(GEN)/libhubbub/treebuilder/autogenerated-element-type.c: $(NS)/libhubbub/src/treebuilder/element-type.gperf
	mkdir -p $(@D)
	$(GPERF) --output-file=$@.tmp $<
	sed -e 's/^\(const struct element_type_map\)/static \1/' $@.tmp > $@ && rm -f $@.tmp

$(GEN)/libcss/gen_parser: $(NS)/libcss/src/parse/properties/css_property_parser_gen.c
	mkdir -p $(@D)
	$(HOSTCC) -O1 -o $@ $<

$(GEN)/libcss/autogenerated_%.c: $(NS)/libcss/src/parse/properties/properties.gen $(GEN)/libcss/gen_parser
	$(GEN)/libcss/gen_parser -o $@ '$(shell grep "^$*:" $(NS)/libcss/src/parse/properties/properties.gen)'

# ---------------------------------------------------------------- one rule set per target
# $(1): target name (host, m68k, tos)  $(2): compiler  $(3): flags

define target_rules
$(1)_PU   := $$(patsubst $(NS)/%.c,build/$(1)/ns/%.o,$$(PU_SRC))
$(1)_WAP  := $$(patsubst $(NS)/%.c,build/$(1)/ns/%.o,$$(WAP_SRC))
$(1)_HUB  := $$(patsubst $(NS)/%.c,build/$(1)/ns/%.o,$$(HUB_SRC))
$(1)_CSS  := $$(patsubst $(NS)/%.c,build/$(1)/ns/%.o,$$(CSS_SRC)) \
             $$(patsubst $(GEN)/libcss/%.c,build/$(1)/ns/libcss/gen/%.o,$$(CSS_GENSRC))
$(1)_NS   := $$($(1)_PU) $$($(1)_WAP) $$($(1)_HUB) $$($(1)_CSS)
$(1)_BENCH := $$(patsubst tests/bench/%.c,build/$(1)/bench/%.o,$$(BENCH_SRC))
$(1)_EC   := $$(patsubst src/css/%.c,build/$(1)/ec/%.o,$$(EC_SRC))

build/$(1)/ns/libparserutils/%.o: $(NS)/libparserutils/%.c $$(GENERATED)
	@mkdir -p $$(@D)
	$(2) $(3) $$(NSDEF) $$(NSINC) $$(PU_INC) -c $$< -o $$@
build/$(1)/ns/libwapcaplet/%.o: $(NS)/libwapcaplet/%.c
	@mkdir -p $$(@D)
	$(2) $(3) $$(NSDEF) $$(NSINC) $$(WAP_INC) -c $$< -o $$@
build/$(1)/ns/libhubbub/%.o: $(NS)/libhubbub/%.c $$(GENERATED)
	@mkdir -p $$(@D)
	$(2) $(3) $$(NSDEF) $$(NSINC) $$(HUB_INC) -c $$< -o $$@
build/$(1)/ns/libcss/%.o: $(NS)/libcss/%.c $$(GENERATED)
	@mkdir -p $$(@D)
	$(2) $(3) $$(NSDEF) $$(NSINC) $$(CSS_INC) -c $$< -o $$@
build/$(1)/ns/libcss/gen/%.o: $(GEN)/libcss/%.c
	@mkdir -p $$(@D)
	$(2) $(3) $$(NSDEF) $$(NSINC) $$(CSS_INC) -I$(NS)/libcss/src/parse/properties -c $$< -o $$@
build/$(1)/bench/%.o: tests/bench/%.c tests/bench/*.h src/css/*.h VERSION
	@mkdir -p $$(@D)
	$(2) $(3) -Wall -Wextra -Wno-unused-parameter -DEWEB_VERSION='"$$(VERSION_STR)"' $$(NSINC) -Isrc/css -c $$< -o $$@
build/$(1)/ec/%.o: src/css/%.c src/css/*.h
	@mkdir -p $$(@D)
	$(2) $$(filter-out -w,$(3)) $$(EC_FLAGS) -c $$< -o $$@
endef

HOST_CFLAGS := -O2 -g -std=gnu99 -DNDEBUG -w
M68K_CFLAGS := -m68030 -m68881 -O2 -std=gnu99 -DNDEBUG -w
# make test's build: NetSurf's assertions on, AddressSanitizer and UBSan
SAN         := -fsanitize=address,undefined -fno-omit-frame-pointer
ASAN_CFLAGS := -O1 -g -std=gnu99 -w $(SAN)

$(eval $(call target_rules,host,$(HOSTCC),$(HOST_CFLAGS)))
$(eval $(call target_rules,m68k,$(M68KCC),$(M68K_CFLAGS)))
$(eval $(call target_rules,asan,$(HOSTCC),$(ASAN_CFLAGS)))

# the Atari: freestanding, with common/'s runtime (crt0, libc, tos) and
# EWeb's additions in atari/ (the C headers and calls NetSurf needs beyond it)
GCCINC     := $(shell $(M68KCC) -print-file-name=include)
TOS_CFLAGS := -m68030 -msoft-float -O2 -std=gnu99 -DNDEBUG -DNSBENCH_TOS -ffreestanding \
              -fno-pic -fno-pie -fno-tree-loop-distribute-patterns -fno-asynchronous-unwind-tables \
              -nostdinc -isystem $(GCCINC) -Iatari/include -Icommon/atari/include -w
TOS_LDFLAGS := -m68030 -msoft-float -nostdlib -static -no-pie -Wl,--emit-relocs -Wl,-T,common/atari/link.ld \
              -Wl,--build-id=none -Wl,-z,noexecstack -Wl,--no-warn-rwx-segments
$(eval $(call target_rules,tos,$(M68KCC),$(TOS_CFLAGS)))
tos_BENCH  := $(subst plat_posix,plat_tos,$(tos_BENCH))
tos_RT     := build/tos/rt/crt0.o build/tos/rt/nf.o build/tos/rt/libc.o build/tos/rt/tos.o \
              build/tos/rt/libc_extra.o

build/tos/rt/%.o: common/atari/%.S
	@mkdir -p $(@D)
	$(M68KCC) -m68030 -DSTACK_SIZE=131072 -c $< -o $@
build/tos/rt/%.o: common/atari/%.c
	@mkdir -p $(@D)
	$(M68KCC) $(TOS_CFLAGS) -c $< -o $@
build/tos/rt/%.o: atari/%.c
	@mkdir -p $(@D)
	$(M68KCC) $(TOS_CFLAGS) -c $< -o $@

build/tos/nsbench.elf: $(tos_RT) $(tos_BENCH) $(tos_EC) $(tos_NS)
	$(M68KCC) $(TOS_LDFLAGS) -o $@ $^ -lgcc

binary/NSBENCH.TTP: build/tos/nsbench.elf common/tools/elf2tos.py
	@mkdir -p binary
	PRGFLAGS=7 python3 common/tools/elf2tos.py $< $@

# NetSurf's libraries alone, for each target
libs: $(host_NS) $(m68k_NS) $(asan_NS)
.PHONY: libs

build/host/nsbench: $(host_BENCH) $(host_EC) $(host_NS)
	$(HOSTCC) -o $@ $^

build/asan/nsbench: $(asan_BENCH) $(asan_EC) $(asan_NS)
	$(HOSTCC) $(SAN) -o $@ $^

build/m68k/nsbench: $(m68k_BENCH) $(m68k_EC) $(m68k_NS)
	$(M68KCC) -m68030 -static -o $@ $^ -lm

# ---------------------------------------------------------------- the network

# EWeb's URL parser and HTTP client (src/net), on common/'s connections,
# TLS (BearSSL 0.6, RSA on the DSP) and STinG; ewget fetches a page with
# them and times it (EWGET.TTP on the Atari)
BSSL      := common/third_party/bearssl
BSSL_SRC  := $(sort $(wildcard $(BSSL)/src/*/*.c))
BSSL_DEF  := -DBR_USE_URANDOM=0 -DBR_USE_GETENTROPY=0 -DBR_USE_UNIX_TIME=0 -DBR_USE_WIN32_TIME=0 \
             -DBR_USE_WIN32_RAND=0 -DBR_RDRAND=0
NET_SRC   := $(sort $(wildcard src/net/*.c))
NETC_SRC  := common/src/conn.c common/src/tls.c common/src/util.c common/src/futil.c
NET_HDRS  := $(wildcard src/*.h src/net/*.h ui/*.h tests/net/*.h common/src/*.h common/atari/*.h \
             common/atari/include/*.h common/ui/*.h atari/include/*.h)
NET_INC   := -Isrc -Isrc/net -Icommon/src -Iatari -Icommon/atari -Iui -Icommon/ui -Itests/net -I$(BSSL)/inc
# EWeb's own files: no warning passes
NET_WARN  := -Wall -Wextra -Wno-unused-parameter -Werror
NET_VER   := -DEWEB_VERSION='"$(VERSION_STR)"'

# this computer: ewget, and the same with AddressSanitizer and UBSan for
# make itest; nettest (make test) plays the servers with fuzz_net.c
HOSTNET_SRC := $(NET_SRC) $(NETC_SRC) tests/host/plat_posix.c
build/host/bssl/%.o: $(BSSL)/src/%.c
	@mkdir -p $(@D)
	$(HOSTCC) -O2 -w -I$(BSSL)/inc -I$(BSSL)/src -c $< -o $@
build/host/libbearssl.a: $(patsubst $(BSSL)/src/%.c,build/host/bssl/%.o,$(BSSL_SRC))
	rm -f $@
	ar rcs $@ $^
build/host/ewget: tests/net/ewget.c tests/net/main_posix.c tests/host/dsp_none.c $(HOSTNET_SRC) $(NET_HDRS) \
		build/host/libbearssl.a VERSION
	$(HOSTCC) -O2 -g -std=gnu99 $(NET_WARN) $(NET_VER) $(NET_INC) -o $@ $(filter %.c,$^) build/host/libbearssl.a
build/asan/ewget: tests/net/ewget.c tests/net/main_posix.c tests/host/dsp_none.c $(HOSTNET_SRC) $(NET_HDRS) \
		build/host/libbearssl.a VERSION
	@mkdir -p $(@D)
	$(HOSTCC) -O1 -g -std=gnu99 $(SAN) $(NET_WARN) $(NET_VER) $(NET_INC) -o $@ $(filter %.c,$^) \
		build/host/libbearssl.a
$(GEN)/net/vectors.h: tests/net/mkvec.py
	@mkdir -p $(@D)
	python3 tests/net/mkvec.py $@
build/asan/nettest: tests/net/nettest.c common/tests/fuzz/fuzz_net.c $(HOSTNET_SRC) $(NET_HDRS) \
		$(GEN)/net/vectors.h build/host/libbearssl.a
	@mkdir -p $(@D)
	$(HOSTCC) -O1 -g -std=gnu99 $(SAN) -fno-sanitize-recover=undefined $(NET_WARN) -DFUZZ_NET $(NET_INC) \
		-Icommon/tests/fuzz -I$(GEN)/net -o $@ $(filter %.c,$^) build/host/libbearssl.a
build/asan/urltest: tests/url/urltest.c src/net/url.c src/net/url.h
	@mkdir -p $(@D)
	$(HOSTCC) -O1 -g -std=gnu99 $(SAN) $(NET_WARN) -Isrc/net -o $@ $(filter %.c,$^)
build/host/mkroots: common/tools/mkroots.c $(HOSTNET_SRC) $(NET_HDRS) build/host/libbearssl.a
	$(HOSTCC) -O2 -std=gnu99 -w $(NET_INC) -o $@ common/tools/mkroots.c $(HOSTNET_SRC) build/host/libbearssl.a

# the Atari: 68030 code (no FPU instructions), on common/'s runtime
TOSNET_CFLAGS := -m68030 -msoft-float -O2 -std=gnu99 -DEW_TOS -ffreestanding -fno-builtin -fno-pic -fno-pie \
                 -fno-tree-loop-distribute-patterns -fno-asynchronous-unwind-tables -nostdinc -isystem $(GCCINC) \
                 -Iatari/include -Icommon/atari/include $(NET_INC)
# common/'s files as the other AERA apps build them
COMMON_WARN   := -Wall -Wno-pointer-sign
TOSNET_OBJ := $(patsubst src/net/%.c,build/tos/net/%.o,$(NET_SRC)) \
              $(addprefix build/tos/net/,conn.o tls.o util.o futil.o net_tos.o sting.o sting_s.o dsprsa.o \
              dsp.o plat_tos.o ecdsp.o dspec.o dsp_ec.o)
build/tos/net/dspec.o: common/dsp/ec_prog.h
build/tos/net/%.o: src/net/%.c $(NET_HDRS)
	@mkdir -p $(@D)
	$(M68KCC) $(TOSNET_CFLAGS) $(NET_WARN) -c $< -o $@
build/tos/net/%.o: atari/%.c $(NET_HDRS)
	@mkdir -p $(@D)
	$(M68KCC) $(TOSNET_CFLAGS) $(NET_WARN) -c $< -o $@
build/tos/net/%.o: common/src/%.c $(NET_HDRS)
	@mkdir -p $(@D)
	$(M68KCC) $(TOSNET_CFLAGS) $(COMMON_WARN) -c $< -o $@
build/tos/net/%.o: common/atari/%.c $(NET_HDRS)
	@mkdir -p $(@D)
	$(M68KCC) $(TOSNET_CFLAGS) $(COMMON_WARN) -c $< -o $@
build/tos/net/%.o: common/ui/%.c $(NET_HDRS)
	@mkdir -p $(@D)
	$(M68KCC) $(TOSNET_CFLAGS) $(COMMON_WARN) -c $< -o $@
build/tos/net/sting_s.o: common/atari/sting.S
	@mkdir -p $(@D)
	$(M68KCC) -m68030 -c $< -o $@
build/tos/ewget/%.o: tests/net/%.c $(NET_HDRS) VERSION
	@mkdir -p $(@D)
	$(M68KCC) $(TOSNET_CFLAGS) $(NET_WARN) $(NET_VER) -c $< -o $@
build/tos/bssl/%.o: $(BSSL)/src/%.c
	@mkdir -p $(@D)
	$(M68KCC) -m68030 -msoft-float -O2 -fomit-frame-pointer -ffreestanding -fno-builtin -fno-pic -fno-pie \
		-fno-tree-loop-distribute-patterns -fno-asynchronous-unwind-tables -w -nostdinc -isystem $(GCCINC) \
		-Iatari/include -Icommon/atari/include -I$(BSSL)/inc -I$(BSSL)/src $(BSSL_DEF) -c $< -o $@
build/tos/libbearssl.a: $(patsubst $(BSSL)/src/%.c,build/tos/bssl/%.o,$(BSSL_SRC))
	rm -f $@
	$(CROSS)ar rcs $@ $^
build/tos/ewget.elf: $(tos_RT) build/tos/ewget/ewget.o build/tos/ewget/main_tos.o $(TOSNET_OBJ) \
		build/tos/libbearssl.a
	$(M68KCC) $(TOS_LDFLAGS) -o $@ $(filter %.o,$^) build/tos/libbearssl.a -lgcc
binary/EWGET.TTP: build/tos/ewget.elf common/tools/elf2tos.py
	@mkdir -p binary
	PRGFLAGS=7 python3 common/tools/elf2tos.py $< $@

# the root certificates: Mozilla's list (common/certs), and the same read
# once into ROOTS.DAT, which the Atari loads in a moment
binary/CACERT.PEM: common/certs/CACERT.PEM
	@mkdir -p binary
	cp $< $@
binary/ROOTS.DAT: binary/CACERT.PEM build/host/mkroots
	build/host/mkroots binary/CACERT.PEM $@

# fuzzing (the AERA guidelines, 7.1): what servers send, and the
# addresses in pages. Needs clang with libFuzzer; make fuzz runs each
# target FUZZTIME seconds from tests/fuzz/seeds (tests/fuzz/mkseeds.py) and
# what once broke them (tests/fuzz/found); make test runs those again
# without libFuzzer (common/tests/fuzz/replay.c)
FUZZCC    ?= clang
FUZZTIME  ?= 60
FUZZERS   := http url
FUZZ_SRC  = $(HOSTNET_SRC) common/tests/fuzz/fuzz_net.c
build/fuzz/fuzz_%: tests/fuzz/fuzz_%.c $(HOSTNET_SRC) $(NET_HDRS) build/host/libbearssl.a
	@mkdir -p $(@D)
	$(FUZZCC) -g -O1 -fsanitize=fuzzer,address,undefined -fno-sanitize-recover=undefined -DFUZZ_NET \
		$(NET_INC) -Icommon/tests/fuzz -o $@ $< $(FUZZ_SRC) build/host/libbearssl.a
build/asan/replay_%: tests/fuzz/fuzz_%.c common/tests/fuzz/replay.c $(HOSTNET_SRC) $(NET_HDRS) build/host/libbearssl.a
	@mkdir -p $(@D)
	$(HOSTCC) -O1 -g -std=gnu99 $(SAN) -fno-sanitize-recover=undefined -DFUZZ_NET $(NET_INC) -Icommon/tests/fuzz \
		-o $@ $< common/tests/fuzz/replay.c $(FUZZ_SRC) build/host/libbearssl.a
fuzz: $(addprefix build/fuzz/fuzz_,$(FUZZERS))
	@for f in $(FUZZERS); do \
	  mkdir -p build/fuzz/corpus/$$f; \
	  echo "fuzz_$$f: $(FUZZTIME) s"; \
	  build/fuzz/fuzz_$$f -max_total_time=$(FUZZTIME) -timeout=10 -rss_limit_mb=1024 \
	    -artifact_prefix=build/fuzz/crash-$$f- build/fuzz/corpus/$$f tests/fuzz/seeds/$$f \
	    $$(ls -d tests/fuzz/found/$$f 2>/dev/null) \
	    > build/fuzz/fuzz_$$f.log 2>&1 || { tail -40 build/fuzz/fuzz_$$f.log; exit 1; }; \
	  grep -E "^#[0-9]+.*DONE" build/fuzz/fuzz_$$f.log | tail -1; \
	done
.PHONY: fuzz

# FAKESTNG.PRG (tools/fakesting, from EMail): a stand-in for STinG that
# carries the emulated Atari's connections over its serial port to
# tests/hatari/serial_bridge.py. For Hatari only, never a real Atari.
FAKE_CFLAGS := -m68000 -Os -fomit-frame-pointer -ffreestanding -fno-builtin -fno-pic -fno-pie \
               -fno-tree-loop-distribute-patterns -fno-store-merging -fno-asynchronous-unwind-tables -Wall \
               -nostdinc -isystem $(GCCINC) -Iatari/include -Icommon/atari/include
build/fakesting/%.o: tools/fakesting/%.c
	@mkdir -p $(@D)
	$(M68KCC) $(FAKE_CFLAGS) -c $< -o $@
build/fakesting/%.o: tools/fakesting/%.S
	@mkdir -p $(@D)
	$(M68KCC) -m68000 -c $< -o $@
build/fakesting/tos.o: common/atari/tos.c
	@mkdir -p $(@D)
	$(M68KCC) $(FAKE_CFLAGS) -c $< -o $@
build/fakesting/nf.o: common/atari/nf.S
	@mkdir -p $(@D)
	$(M68KCC) -m68000 -c $< -o $@
build/fakesting/FAKESTNG.PRG: $(addprefix build/fakesting/,fstart.o fakesting.o tos.o nf.o fstr.o) tools/fakesting/link.ld
	$(M68KCC) -m68000 -nostdlib -static -no-pie -Wl,--emit-relocs -Wl,-T,tools/fakesting/link.ld \
		-Wl,--build-id=none -Wl,-z,noexecstack -Wl,--no-warn-rwx-segments -o $(@:.PRG=.elf) $(filter %.o,$^)
	python3 common/tools/elf2tos.py $(@:.PRG=.elf) $@

# EWGET.TTP on an emulated Falcon (Hatari, EmuTOS's etos1024k.img in
# build/), through FAKESTNG, against tests/net/server.py: TLS on the 68030,
# RSA and the elliptic curves on the emulated DSP
hatarinet: binary/EWGET.TTP build/fakesting/FAKESTNG.PRG
	python3 tests/hatari/ewget_test.py build/etos1024k.img
.PHONY: hatarinet

# against servers on this computer: plain, TLS, redirects, refused certificates
itest: build/asan/ewget
	python3 tests/net/itest.py build/asan/ewget build/itest
.PHONY: itest

# the URL Standard's tests (tests/url/fetch.sh first)
urltest: build/asan/urltest
	@test -f build/wpt/url/resources/urltestdata.json || { echo "no tests: run tests/url/fetch.sh"; exit 1; }
	python3 tests/url/run.py build/asan/urltest
.PHONY: urltest

# ---------------------------------------------------------------- tests

# Hubbub against the tree-construction tests (tests/html5lib/fetch.sh puts
# them in build/wpt): on this computer, and as big-endian 68030 code
H5DATA := $(wildcard build/wpt/html/syntax/parsing/resources/*.dat)

build/host/h5/h5test.o: tests/html5lib/h5test.c
	@mkdir -p $(@D)
	$(HOSTCC) $(HOST_CFLAGS) $(NSDEF) $(NSINC) -c $< -o $@
build/host/h5test: build/host/h5/h5test.o $(host_PU) $(host_WAP) $(host_HUB)
	$(HOSTCC) -o $@ $^
build/m68k/h5/h5test.o: tests/html5lib/h5test.c
	@mkdir -p $(@D)
	$(M68KCC) $(M68K_CFLAGS) $(NSDEF) $(NSINC) -c $< -o $@
build/m68k/h5test: build/m68k/h5/h5test.o $(m68k_PU) $(m68k_WAP) $(m68k_HUB)
	$(M68KCC) -m68030 -static -o $@ $^

h5test: build/host/h5test build/m68k/h5test
	@test -n "$(H5DATA)" || { echo "no tests: run tests/html5lib/fetch.sh"; exit 1; }
	build/host/h5test $(H5DATA) | tail -1
	qemu-m68k -cpu m68030 build/m68k/h5test $(H5DATA) | tail -1
.PHONY: h5test

# EWeb's CSS engine against LibCSS, value by value (tests/css/csscmp.c)
$(GEN)/css/lcnames.inc: tests/css/lcnames.py $(NS)/libcss/include/libcss/properties.h
	@mkdir -p $(@D)
	python3 tests/css/lcnames.py $(NS)/libcss/include/libcss/properties.h $@
build/host/css/csscmp.o: tests/css/csscmp.c $(GEN)/css/lcnames.inc tests/bench/*.h src/css/*.h
	@mkdir -p $(@D)
	$(HOSTCC) -O2 -g -std=gnu99 -Wall -Wextra -Wno-unused-parameter $(NSINC) -Itests/bench -Isrc/css \
		-I$(GEN)/css -c $< -o $@
build/host/csscmp: build/host/css/csscmp.o $(filter-out %/nsbench.o,$(host_BENCH)) $(host_EC) $(host_NS)
	$(HOSTCC) -o $@ $^
build/asan/css/csscmp.o: tests/css/csscmp.c $(GEN)/css/lcnames.inc tests/bench/*.h src/css/*.h
	@mkdir -p $(@D)
	$(HOSTCC) $(ASAN_CFLAGS) $(NSINC) -Itests/bench -Isrc/css -I$(GEN)/css -c $< -o $@
build/asan/csscmp: build/asan/css/csscmp.o $(filter-out %/nsbench.o,$(asan_BENCH)) $(asan_EC) $(asan_NS)
	$(HOSTCC) $(SAN) -o $@ $^

# EWeb's CSS engine against cases worked out from the specifications
build/asan/css/ectest.o: tests/css/ectest.c tests/bench/*.h src/css/*.h
	@mkdir -p $(@D)
	$(HOSTCC) $(filter-out -w,$(ASAN_CFLAGS)) -Wall -Wextra -Wno-unused-parameter $(NSINC) \
		-Itests/bench -Isrc/css -c $< -o $@
build/asan/ectest: build/asan/css/ectest.o $(filter-out %/nsbench.o,$(asan_BENCH)) $(asan_EC) $(asan_NS)
	$(HOSTCC) $(SAN) -o $@ $^

# the comparison on the whole page set (tests/bench/pages.sh first): every
# difference from LibCSS should have a reason
csscmp: build/host/csscmp
	@test -d build/pages/pages || { echo "no pages: run tests/bench/pages.sh"; exit 1; }
	build/host/csscmp -n 1 -s build/pages/css/bootstrap.min.css build/pages/pages/* | tail -22
	build/host/csscmp -n 1 -s build/pages/css/pico.min.css build/pages/pages/* | tail -22
.PHONY: csscmp

# Hebrew pages in every Hebrew encoding (tests/hebrew)
build/asan/hebrew/hebtest.o: tests/hebrew/hebtest.c tests/bench/dom.h
	@mkdir -p $(@D)
	$(HOSTCC) $(ASAN_CFLAGS) $(NSINC) -Itests/bench -c $< -o $@
build/asan/hebtest: build/asan/hebrew/hebtest.o build/asan/bench/dom.o $(asan_PU) $(asan_WAP) $(asan_HUB)
	$(HOSTCC) $(SAN) -o $@ $^
build/m68k/hebrew/hebtest.o: tests/hebrew/hebtest.c tests/bench/dom.h
	@mkdir -p $(@D)
	$(M68KCC) $(M68K_CFLAGS) $(NSINC) -Itests/bench -c $< -o $@
build/m68k/hebtest: build/m68k/hebrew/hebtest.o build/m68k/bench/dom.o $(m68k_PU) $(m68k_WAP) $(m68k_HUB)
	$(M68KCC) -m68030 -static -o $@ $^

# libparserutils' input stream: UTF-8 and other charsets in random chunks
# (tests/input)
build/asan/input/streamtest.o: tests/input/streamtest.c
	@mkdir -p $(@D)
	$(HOSTCC) $(filter-out -w,$(ASAN_CFLAGS)) -Wall -Wextra $(NSINC) -c $< -o $@
build/asan/streamtest: build/asan/input/streamtest.o $(asan_PU)
	$(HOSTCC) $(SAN) -o $@ $^
build/m68k/input/streamtest.o: tests/input/streamtest.c
	@mkdir -p $(@D)
	$(M68KCC) $(M68K_CFLAGS) $(NSINC) -c $< -o $@
build/m68k/streamtest: build/m68k/input/streamtest.o $(m68k_PU)
	$(M68KCC) -m68030 -static -o $@ $^

# a made-up news front page the size of the page set's median, and its
# stylesheet (tests/bench/mkpage.py writes the same bytes every time)
build/news/NEWS.HTM build/news/NEWS.CSS: tests/bench/mkpage.py
	python3 tests/bench/mkpage.py build/news

# (Hubbub prints its tree builder's states when NDEBUG is off: they go)
test: build/asan/nsbench build/asan/hebtest build/asan/ectest build/asan/csscmp build/asan/streamtest \
		build/asan/nettest $(addprefix build/asan/replay_,$(FUZZERS)) build/news/NEWS.HTM
	build/asan/streamtest
	build/asan/nettest
	@for f in $(FUZZERS); do build/asan/replay_$$f tests/fuzz/seeds/$$f $$(ls -d tests/fuzz/found/$$f 2>/dev/null) || exit 1; done
	build/asan/nsbench -E both tests/bench/sample.html > /dev/null
	build/asan/nsbench -E both build/news/NEWS.HTM build/news/NEWS.CSS > /dev/null
	tests/hebrew/run.sh build/asan/hebtest
	build/asan/ectest tests/css/cases.txt
	build/asan/csscmp -s build/news/NEWS.CSS build/news/NEWS.HTM tests/bench/sample.html \
		tests/hebrew/*.HTM | tail -1

# the Hebrew pages and the input stream as 68030 code too (qemu-user)
hebtest68k: build/m68k/hebtest build/m68k/streamtest
	tests/hebrew/run.sh build/m68k/hebtest qemu-m68k -cpu m68030
	qemu-m68k -cpu m68030 build/m68k/streamtest
.PHONY: hebtest68k

# a release's files: each on its own, and all of them in EWEB-x.y.zip
# (the Atari's text files with CR/LF)
dist: binary/NSBENCH.TTP binary/EWGET.TTP binary/CACERT.PEM binary/ROOTS.DAT docs/NSBENCH.TXT \
		docs/EWGET.TXT tests/bench/sample.html build/news/NEWS.HTM
	rm -rf dist
	mkdir -p dist/zip
	cp binary/NSBENCH.TTP binary/EWGET.TTP binary/CACERT.PEM binary/ROOTS.DAT dist/
	sed 's/$$/\r/' docs/NSBENCH.TXT > dist/NSBENCH.TXT
	sed 's/$$/\r/' docs/EWGET.TXT > dist/EWGET.TXT
	sed 's/$$/\r/' tests/bench/sample.html > dist/SAMPLE.HTM
	sed 's/$$/\r/' build/news/NEWS.HTM > dist/NEWS.HTM
	sed 's/$$/\r/' build/news/NEWS.CSS > dist/NEWS.CSS
	cp dist/NSBENCH.TTP dist/NSBENCH.TXT dist/EWGET.TTP dist/EWGET.TXT dist/CACERT.PEM dist/ROOTS.DAT \
		dist/SAMPLE.HTM dist/NEWS.HTM dist/NEWS.CSS dist/zip/
	cd dist/zip && zip -q -9 -r ../EWEB-$(VERSION_STR).zip .
	rm -rf dist/zip
.PHONY: dist

clean:
	rm -rf build binary dist
