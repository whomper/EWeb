# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2026 AERA | Erez Yaary
# EWeb - a web browser for the Atari Falcon: EWEB.PRG, its fonts, and the
# tools its first milestone measured with (nsbench, which parses a saved
# page with NetSurf's HTML parser and styles it with LibCSS and with
# EWeb's own CSS engine; ewget, which fetches a page and times it). See
# docs/DESIGN.md.
#
#   make             binary/EWEB.PRG (the browser) with EWEBJS.OVL (its
#                    JavaScript), EWEBST.PRG, binary/EWEB.FNT (its
#                    fonts, from DejaVu), NSBENCH.TTP and EWGET.TTP for the
#                    Atari (plain TOS, any Falcon), with common/'s
#                    freestanding runtime, and the root certificates
#                    (CACERT.PEM, ROOTS.DAT)
#   make help        binary/EWEB.HYP, the guide (HCP=/path/to/hcp)
#   make bench       build/host/nsbench, for this computer
#   make bench68k    build/m68k/nsbench, a Linux 68030 program for counting
#                    instructions under QEMU (tools/count68k.sh)
#   make test        nsbench on the test pages, the Hebrew pages, the CSS
#                    engine's cases, the input stream, the HTTP client, the
#                    fuzz targets' inputs and the layout's pages
#                    (tests/layout, and the ST edition's gradients and
#                    details clicked), with
#                    AddressSanitizer and UBSan
#   make itest       ewget and the browser against servers on this computer
#                    (TCP, TLS)
#   make hatarinet   EWGET.TTP in Hatari through FAKESTNG, against them
#   make hatarigui   EWEB.PRG in Hatari (tests/hatari/gui_test.py)
#   make hatarifiles what they do on the disk, against the budgets (6.5)
#   make urltest     the URL parser against the URL Standard's tests
#                    (tests/url/fetch.sh first)
#   make fuzz        the HTTP client and the URL parser under libFuzzer
#   make h5test      Hubbub against the HTML tree-construction tests
#                    (tests/html5lib/fetch.sh first)
#   make dist        a release's files in dist/: EWEB.PRG, EWEBJS.OVL,
#                    EWEBST.PRG, EWEB.FNT, EWEB.HYP,
#                    NSBENCH.TTP, NSBENCH.TXT, PICBENCH.TTP, PICBENCH.TXT,
#                    PHOTO.JPG, EWGET.TTP, EWGET.TXT,
#                    CACERT.PEM, ROOTS.DAT, SAMPLE.HTM, NEWS.HTM, NEWS.CSS and
#                    EWEB-x.y.zip (with the desktop icon, icons/)
#
# Needs: gcc-m68k-linux-gnu, perl, gperf, python3, Pillow (tools/requirements.txt),
# fonts-dejavu-core and fonts-dejavu-extra; hatari, Xvfb and xdotool for the rigs.
#
# NetSurf's libraries are in third_party/netsurf (MIT licence, see each
# COPYING). Their generated sources (character set aliases, HTML entities,
# the element-type hash, LibCSS's property parsers) are made in build/gen,
# so a build changes no tracked file.

# the version: VERSION holds the last release (major.minor) and the build
# never writes it; tools/bump.py starts a release
VERSION_STR := $(shell cat VERSION)

CROSS    ?= m68k-linux-gnu-
HOSTCC   ?= gcc
M68KCC   := $(CROSS)gcc
PERL     ?= perl
# NetSurf's generators walk perl hashes, whose order perl randomises on
# each run: Hubbub's entity tree came out different every build, so no
# two builds of EWEB.PRG or NSBENCH.TTP matched. A fixed seed keeps the
# same order (a mixed one: sorted, the entity tree would be a list)
PERL_FIXED := PERL_HASH_SEED=0 PERL_PERTURB_KEYS=0 $(PERL)
GPERF    ?= gperf

NS       := third_party/netsurf
GEN      := build/gen

# ---------------------------------------------------------------- sources

PU_SRC   := $(sort $(shell find $(NS)/libparserutils/src -name '*.c'))
# (their headers too, as a patch changes tables kept in them)
PU_HDRS  := $(shell find $(NS)/libparserutils -name '*.h')
HUB_HDRS := $(shell find $(NS)/libhubbub -name '*.h')
WAP_SRC  := $(NS)/libwapcaplet/src/libwapcaplet.c
HUB_SRC  := $(sort $(shell find $(NS)/libhubbub/src -name '*.c'))
CSS_SRC  := $(sort $(filter-out %/css_property_parser_gen.c,$(shell find $(NS)/libcss/src -name '*.c')))
CSS_PROPS := $(shell sed -n 's/^\([a-z_-][a-z_-]*\):.*/\1/p' $(NS)/libcss/src/parse/properties/properties.gen)
CSS_GENSRC := $(patsubst %,$(GEN)/libcss/autogenerated_%.c,$(CSS_PROPS))
BENCH_SRC := tests/bench/nsbench.c tests/bench/dom.c tests/bench/style.c tests/bench/ecstyle.c \
             tests/bench/plat_posix.c
# EWeb's own CSS engine
EC_SRC   := $(sort $(wildcard src/css/*.c))
EC_FLAGS := -Wall -Wextra -Wno-unused-parameter -Werror -Isrc/css
# EWeb's browser: the document, the layout, the drawing, the browsing
# (src/doc, src/layout, src/gfx, src/browse: this on the network's code)
EWB_SRC  := $(sort $(wildcard src/doc/*.c src/layout/*.c src/gfx/*.c src/browse/*.c))
EWB_HDRS = $(wildcard src/doc/*.h src/layout/*.h src/gfx/*.h src/browse/*.h src/css/*.h src/js/*.h) $(NET_HDRS)
EWB_INC  = -Isrc -Isrc/doc -Isrc/layout -Isrc/gfx -Isrc/browse -Isrc/css -Isrc/js $(NET_INC)
EWB_FLAGS = -Wall -Wextra -Wno-unused-parameter -Werror $(EWB_INC) -I$(GEN) $(NET_VER)

# what NetSurf's build system defines for its libraries; and no iconv: the
# Atari has none, so every build converts character sets with
# libparserutils' own codecs, the code the Falcon runs
NSDEF    := -D_ALIGNED="__attribute__((aligned))" -D_BSD_SOURCE -D_DEFAULT_SOURCE \
            -DWITHOUT_ICONV_FILTER

# each library sees its own src/ (they share header names such as
# utils/utils.h) and the public headers of all of them
NSINC    := -I$(NS)/libparserutils/include -I$(NS)/libwapcaplet/include \
            -I$(NS)/libhubbub/include -I$(NS)/libcss/include
PU_INC   := -I$(NS)/libparserutils/src -I$(GEN)/libparserutils
HUB_INC  := -I$(NS)/libhubbub/src -I$(GEN)/libhubbub
CSS_INC  := -I$(NS)/libcss/src
WAP_INC  := -I$(NS)/libwapcaplet/src

GENERATED := $(GEN)/libparserutils/aliases.inc $(GEN)/libhubbub/entities.inc \
             $(GEN)/libhubbub/treebuilder/autogenerated-element-type.c $(CSS_GENSRC)

# make keeps them: they are inputs, not leftovers
.SECONDARY: $(CSS_GENSRC)

# ---------------------------------------------------------------- targets

all: binary/EWEB.PRG binary/EWEBJS.OVL binary/EWEBST.PRG binary/EWEB.FNT binary/NSBENCH.TTP binary/EWGET.TTP binary/ROOTS.DAT

bench: build/host/nsbench build/host/ewget
bench68k: build/m68k/nsbench

.PHONY: all bench bench68k test clean

# ---------------------------------------------------------------- generated sources

$(GEN)/libparserutils/aliases.inc: $(NS)/libparserutils/build/make-aliases.pl $(NS)/libparserutils/build/Aliases
	rm -rf $(GEN)/pu-stage && mkdir -p $(GEN)/pu-stage/build $(GEN)/pu-stage/src/charset $(@D)
	cp $(NS)/libparserutils/build/Aliases $(GEN)/pu-stage/build/
	cd $(GEN)/pu-stage && $(PERL_FIXED) $(CURDIR)/$(NS)/libparserutils/build/make-aliases.pl >/dev/null
	mv $(GEN)/pu-stage/src/charset/aliases.inc $@ && rm -rf $(GEN)/pu-stage

# the HTML parser's named character references (src/doc/html.c)
$(GEN)/entities.h: tools/mkentities.py src/doc/entities.txt
	@mkdir -p $(@D)
	python3 tools/mkentities.py src/doc/entities.txt $@
$(GEN)/libhubbub/entities.inc: $(NS)/libhubbub/build/make-entities.pl $(NS)/libhubbub/build/Entities
	rm -rf $(GEN)/hub-stage && mkdir -p $(GEN)/hub-stage/build $(GEN)/hub-stage/src/tokeniser $(@D)
	cp $(NS)/libhubbub/build/Entities $(GEN)/hub-stage/build/
	cd $(GEN)/hub-stage && $(PERL_FIXED) $(CURDIR)/$(NS)/libhubbub/build/make-entities.pl >/dev/null
	mv $(GEN)/hub-stage/src/tokeniser/entities.inc $@ && rm -rf $(GEN)/hub-stage

$(GEN)/libhubbub/treebuilder/autogenerated-element-type.c: $(NS)/libhubbub/src/treebuilder/element-type.gperf
	mkdir -p $(@D)
	$(GPERF) --output-file=$@.tmp $<
	sed -e 's/^\(const struct element_type_map\)/static \1/' $@.tmp > $@ && rm -f $@.tmp

$(GEN)/libcss/gen_parser: $(NS)/libcss/src/parse/properties/css_property_parser_gen.c
	mkdir -p $(@D)
	$(HOSTCC) -O1 -o $@ $<

$(GEN)/libcss/autogenerated_%.c: $(NS)/libcss/src/parse/properties/properties.gen $(GEN)/libcss/gen_parser
	$(GEN)/libcss/gen_parser -o $@ '$(shell grep "^$*:" $(NS)/libcss/src/parse/properties/properties.gen)'

# ---------------------------------------------------------------- one rule set per target
# $(1): target name (host, m68k, tos)  $(2): compiler  $(3): flags

define target_rules
$(1)_PU   := $$(patsubst $(NS)/%.c,build/$(1)/ns/%.o,$$(PU_SRC))
$(1)_WAP  := $$(patsubst $(NS)/%.c,build/$(1)/ns/%.o,$$(WAP_SRC))
$(1)_HUB  := $$(patsubst $(NS)/%.c,build/$(1)/ns/%.o,$$(HUB_SRC))
$(1)_CSS  := $$(patsubst $(NS)/%.c,build/$(1)/ns/%.o,$$(CSS_SRC)) \
             $$(patsubst $(GEN)/libcss/%.c,build/$(1)/ns/libcss/gen/%.o,$$(CSS_GENSRC))
$(1)_NS   := $$($(1)_PU) $$($(1)_WAP) $$($(1)_HUB) $$($(1)_CSS)
$(1)_BENCH := $$(patsubst tests/bench/%.c,build/$(1)/bench/%.o,$$(BENCH_SRC))
$(1)_EC   := $$(patsubst src/css/%.c,build/$(1)/ec/%.o,$$(EC_SRC))
$(1)_EWB  := $$(patsubst src/%.c,build/$(1)/ewb/%.o,$$(EWB_SRC))

build/$(1)/ns/libparserutils/%.o: $(NS)/libparserutils/%.c $$(GENERATED) $$(PU_HDRS)
	@mkdir -p $$(@D)
	$(2) $(3) $$(NSDEF) $$(NSINC) $$(PU_INC) -c $$< -o $$@
build/$(1)/ns/libwapcaplet/%.o: $(NS)/libwapcaplet/%.c
	@mkdir -p $$(@D)
	$(2) $(3) $$(NSDEF) $$(NSINC) $$(WAP_INC) -c $$< -o $$@
build/$(1)/ns/libhubbub/%.o: $(NS)/libhubbub/%.c $$(GENERATED) $$(PU_HDRS) $$(HUB_HDRS)
	@mkdir -p $$(@D)
	$(2) $(3) $$(NSDEF) $$(NSINC) $$(HUB_INC) -c $$< -o $$@
build/$(1)/ns/libcss/%.o: $(NS)/libcss/%.c $$(GENERATED)
	@mkdir -p $$(@D)
	$(2) $(3) $$(NSDEF) $$(NSINC) $$(CSS_INC) -c $$< -o $$@
build/$(1)/ns/libcss/gen/%.o: $(GEN)/libcss/%.c
	@mkdir -p $$(@D)
	$(2) $(3) $$(NSDEF) $$(NSINC) $$(CSS_INC) -I$(NS)/libcss/src/parse/properties -c $$< -o $$@
build/$(1)/bench/%.o: tests/bench/%.c tests/bench/*.h src/css/*.h src/doc/*.h VERSION
	@mkdir -p $$(@D)
	$(2) $(3) -Wall -Wextra -Wno-unused-parameter -DEWEB_VERSION='"$$(VERSION_STR)"' $$(NSINC) -Isrc/css -Isrc/doc -c $$< -o $$@
build/$(1)/ec/%.o: src/css/%.c src/css/*.h
	@mkdir -p $$(@D)
	$(2) $$(filter-out -w,$(3)) $$(EC_FLAGS) -c $$< -o $$@
build/$(1)/ewb/doc/html.o: $(GEN)/entities.h
build/$(1)/ewb/%.o: src/%.c $$(EWB_HDRS) VERSION
	@mkdir -p $$(@D)
	$(2) $$(filter-out -w,$(3)) $(if $(filter tos st,$(1)),-DEW_TOS) $$(EWB_FLAGS) $$(NSINC) -c $$< -o $$@
endef

HOST_CFLAGS := -O2 -g -std=gnu99 -DNDEBUG -w
M68K_CFLAGS := -m68030 -m68881 -O2 -std=gnu99 -DNDEBUG -w
# make test's build: NetSurf's assertions on, AddressSanitizer and UBSan
SAN         := -fsanitize=address,undefined -fno-omit-frame-pointer
ASAN_CFLAGS := -O1 -g -std=gnu99 -w $(SAN)

$(eval $(call target_rules,host,$(HOSTCC),$(HOST_CFLAGS)))
$(eval $(call target_rules,m68k,$(M68KCC),$(M68K_CFLAGS)))
$(eval $(call target_rules,asan,$(HOSTCC),$(ASAN_CFLAGS)))

# the Atari: freestanding, with common/'s runtime (crt0, libc, tos) and
# EWeb's additions in atari/ (the C headers and calls NetSurf needs beyond it)
GCCINC     := $(shell $(M68KCC) -print-file-name=include)
# the programs' stacks (crt0's, in the BSS): a page's depth costs about
# 700 bytes of stack a level in the layout, and the layout stops short of
# the end (ui/main.c, EW_STACK_ROOM; DESIGN.md, The stack). The ST
# edition's the same since its 1 MB ST was dropped.
TOS_STACK := 262144
ST_STACK  := $(TOS_STACK)
# (crt0 and main.c are made again when they change: the two must agree)
build/tos/gem/main.o build/st/gem/main.o: Makefile
TOS_CFLAGS := -m68030 -msoft-float -O2 -std=gnu99 -DNDEBUG -DNSBENCH_TOS -ffreestanding \
              -fno-pic -fno-pie -fno-tree-loop-distribute-patterns -fno-asynchronous-unwind-tables \
              -nostdinc -isystem $(GCCINC) -Iatari/include -Icommon/atari/include -w
TOS_LDFLAGS := -m68030 -msoft-float -nostdlib -static -no-pie -Wl,--emit-relocs -Wl,-T,common/atari/link.ld \
              -Wl,--build-id=none -Wl,-z,noexecstack -Wl,--no-warn-rwx-segments
$(eval $(call target_rules,tos,$(M68KCC),$(TOS_CFLAGS)))
tos_BENCH  := $(subst plat_posix,plat_tos,$(tos_BENCH))
tos_RT     := build/tos/rt/crt0.o build/tos/rt/nf.o build/tos/rt/libc.o build/tos/rt/tos.o \
              build/tos/rt/libc_extra.o

build/tos/rt/%.o: common/atari/%.S Makefile
	@mkdir -p $(@D)
	$(M68KCC) -m68030 -DSTACK_SIZE=$(TOS_STACK) -c $< -o $@
build/tos/rt/%.o: common/atari/%.c
	@mkdir -p $(@D)
	$(M68KCC) $(TOS_CFLAGS) -c $< -o $@
build/tos/rt/%.o: atari/%.c
	@mkdir -p $(@D)
	$(M68KCC) $(TOS_CFLAGS) -c $< -o $@

build/tos/nsbench.elf: $(tos_RT) $(tos_BENCH) $(tos_EC) $(tos_NS)
	$(M68KCC) $(TOS_LDFLAGS) -o $@ $^ -lgcc

binary/NSBENCH.TTP: build/tos/nsbench.elf common/tools/elf2tos.py
	@mkdir -p binary
	PRGFLAGS=7 python3 common/tools/elf2tos.py $< $@

# NetSurf's libraries alone, for each target
libs: $(host_NS) $(m68k_NS) $(asan_NS)
.PHONY: libs

build/host/nsbench: $(host_BENCH) $(host_EC) $(host_NS)
	$(HOSTCC) -o $@ $^

build/asan/nsbench: $(asan_BENCH) $(asan_EC) $(asan_NS)
	$(HOSTCC) $(SAN) -o $@ $^

build/m68k/nsbench: $(m68k_BENCH) $(m68k_EC) $(m68k_NS)
	$(M68KCC) -m68030 -static -o $@ $^ -lm

# ---------------------------------------------------------------- the network

# EWeb's URL parser and HTTP client (src/net), on common/'s connections,
# TLS (BearSSL 0.6, RSA on the DSP) and STinG; ewget fetches a page with
# them and times it (EWGET.TTP on the Atari)
BSSL      := common/third_party/bearssl
BSSL_SRC  := $(sort $(wildcard $(BSSL)/src/*/*.c))
BSSL_DEF  := -DBR_USE_URANDOM=0 -DBR_USE_GETENTROPY=0 -DBR_USE_UNIX_TIME=0 -DBR_USE_WIN32_TIME=0 \
             -DBR_USE_WIN32_RAND=0 -DBR_RDRAND=0
NET_SRC   := $(sort $(wildcard src/net/*.c))
NETC_SRC  := common/src/conn.c common/src/tls.c common/src/util.c common/src/futil.c common/src/inflate.c \
             common/src/secret.c
NET_HDRS  := $(wildcard src/*.h src/net/*.h ui/*.h tests/net/*.h common/src/*.h common/atari/*.h \
             common/atari/include/*.h common/ui/*.h atari/include/*.h)
NET_INC   := -Isrc -Isrc/net -Icommon/src -Iatari -Icommon/atari -Iui -Icommon/ui -Itests/net -I$(BSSL)/inc
# EWeb's own files: no warning passes
NET_WARN  := -Wall -Wextra -Wno-unused-parameter -Werror
NET_VER   := -DEWEB_VERSION='"$(VERSION_STR)"'

# this computer: ewget, and the same with AddressSanitizer and UBSan for
# make itest; nettest (make test) plays the servers with fuzz_net.c
HOSTNET_SRC := $(NET_SRC) $(NETC_SRC) tests/host/plat_posix.c
build/host/bssl/%.o: $(BSSL)/src/%.c
	@mkdir -p $(@D)
	$(HOSTCC) -O2 -w -I$(BSSL)/inc -I$(BSSL)/src -c $< -o $@
build/host/libbearssl.a: $(patsubst $(BSSL)/src/%.c,build/host/bssl/%.o,$(BSSL_SRC))
	rm -f $@
	ar rcs $@ $^
build/host/ewget: tests/net/ewget.c tests/net/main_posix.c tests/host/dsp_none.c $(HOSTNET_SRC) $(NET_HDRS) \
		build/host/libbearssl.a VERSION
	$(HOSTCC) -O2 -g -std=gnu99 $(NET_WARN) $(NET_VER) $(NET_INC) -o $@ $(filter %.c,$^) build/host/libbearssl.a
build/asan/ewget: tests/net/ewget.c tests/net/main_posix.c tests/host/dsp_none.c $(HOSTNET_SRC) $(NET_HDRS) \
		build/host/libbearssl.a VERSION
	@mkdir -p $(@D)
	$(HOSTCC) -O1 -g -std=gnu99 $(SAN) $(NET_WARN) $(NET_VER) $(NET_INC) -o $@ $(filter %.c,$^) \
		build/host/libbearssl.a
$(GEN)/net/vectors.h: tests/net/mkvec.py
	@mkdir -p $(@D)
	python3 tests/net/mkvec.py $@
build/asan/nettest: tests/net/nettest.c common/tests/fuzz/fuzz_net.c $(HOSTNET_SRC) $(NET_HDRS) \
		$(GEN)/net/vectors.h build/host/libbearssl.a
	@mkdir -p $(@D)
	$(HOSTCC) -O1 -g -std=gnu99 $(SAN) -fno-sanitize-recover=undefined $(NET_WARN) -DFUZZ_NET $(NET_INC) \
		-Icommon/tests/fuzz -I$(GEN)/net -o $@ $(filter %.c,$^) build/host/libbearssl.a
build/asan/cookietest: tests/net/cookietest.c $(HOSTNET_SRC) $(NET_HDRS) build/host/libbearssl.a
	@mkdir -p $(@D)
	$(HOSTCC) -O1 -g -std=gnu99 $(SAN) -fno-sanitize-recover=undefined $(NET_WARN) $(NET_INC) \
		-o $@ $(filter %.c,$^) build/host/libbearssl.a
# the bookmarks (src/browse/bookmark.c)
build/asan/bmtest: tests/browse/bmtest.c src/browse/bookmark.c src/browse/bookmark.h common/src/util.c \
		common/src/futil.c tests/host/plat_posix.c
	@mkdir -p $(@D)
	$(HOSTCC) -O1 -g -std=gnu99 $(SAN) -fno-sanitize-recover=undefined $(NET_WARN) -Isrc -Isrc/browse \
		-Icommon/src -o $@ $(filter %.c,$^)
# the disk cache (src/browse/dcache.c)
build/asan/dctest: tests/browse/dctest.c src/browse/dcache.c src/browse/dcache.h $(HOSTNET_SRC) $(NET_HDRS) \
		build/host/libbearssl.a
	@mkdir -p $(@D)
	$(HOSTCC) -O1 -g -std=gnu99 $(SAN) -fno-sanitize-recover=undefined $(NET_WARN) $(NET_INC) -Isrc/browse \
		-o $@ $(filter %.c,$^) build/host/libbearssl.a
# pictures that come as pens from the Pi (src/browse/img.c)
build/asan/pentest: tests/browse/pentest.c src/browse/img.c src/browse/img.h src/browse/dcache.c $(HOSTNET_SRC) \
		$(NET_HDRS) build/host/libbearssl.a build/asan/pic.a
	@mkdir -p $(@D)
	$(HOSTCC) -O1 -g -std=gnu99 $(SAN) -fno-sanitize-recover=undefined $(NET_WARN) $(NET_INC) -Isrc/browse \
		-o $@ $(filter %.c,$^) build/asan/pic.a build/host/libbearssl.a
build/asan/urltest: tests/url/urltest.c src/net/url.c src/net/url.h
	@mkdir -p $(@D)
	$(HOSTCC) -O1 -g -std=gnu99 $(SAN) $(NET_WARN) -Isrc/net -o $@ $(filter %.c,$^)
build/host/mkroots: common/tools/mkroots.c $(HOSTNET_SRC) $(NET_HDRS) build/host/libbearssl.a
	$(HOSTCC) -O2 -std=gnu99 -w $(NET_INC) -o $@ common/tools/mkroots.c $(HOSTNET_SRC) build/host/libbearssl.a

# the Atari: 68030 code (no FPU instructions), on common/'s runtime
TOSNET_CFLAGS := -m68030 -msoft-float -O2 -std=gnu99 -DEW_TOS -ffreestanding -fno-builtin -fno-pic -fno-pie \
                 -fno-tree-loop-distribute-patterns -fno-asynchronous-unwind-tables -nostdinc -isystem $(GCCINC) \
                 -Iatari/include -Icommon/atari/include $(NET_INC)
# common/'s files as the other AERA apps build them
COMMON_WARN   := -Wall -Wno-pointer-sign
TOSNET_OBJ := $(patsubst src/net/%.c,build/tos/net/%.o,$(NET_SRC)) \
              $(addprefix build/tos/net/,conn.o tls.o util.o futil.o inflate.o secret.o net_tos.o sting.o sting_s.o dsprsa.o \
              dsp.o plat_tos.o ecdsp.o dspec.o dsp_ec.o crash.o crash_s.o bigbuf.o)
build/tos/net/dspec.o: common/dsp/ec_prog.h
build/tos/net/%.o: src/net/%.c $(NET_HDRS)
	@mkdir -p $(@D)
	$(M68KCC) $(TOSNET_CFLAGS) $(NET_WARN) -c $< -o $@
build/tos/net/%.o: atari/%.c $(NET_HDRS)
	@mkdir -p $(@D)
	$(M68KCC) $(TOSNET_CFLAGS) $(NET_WARN) -c $< -o $@
build/tos/net/%.o: common/src/%.c $(NET_HDRS)
	@mkdir -p $(@D)
	$(M68KCC) $(TOSNET_CFLAGS) $(COMMON_WARN) -c $< -o $@
build/tos/net/%.o: common/atari/%.c $(NET_HDRS)
	@mkdir -p $(@D)
	$(M68KCC) $(TOSNET_CFLAGS) $(COMMON_WARN) -c $< -o $@
build/tos/net/%.o: common/ui/%.c $(NET_HDRS)
	@mkdir -p $(@D)
	$(M68KCC) $(TOSNET_CFLAGS) $(COMMON_WARN) -c $< -o $@
build/tos/net/sting_s.o: common/atari/sting.S
	@mkdir -p $(@D)
	$(M68KCC) -m68030 -c $< -o $@
build/tos/net/crash_s.o: common/atari/crash.S
	@mkdir -p $(@D)
	$(M68KCC) -m68030 -c $< -o $@
build/tos/ewget/%.o: tests/net/%.c $(NET_HDRS) VERSION
	@mkdir -p $(@D)
	$(M68KCC) $(TOSNET_CFLAGS) $(NET_WARN) $(NET_VER) -c $< -o $@
build/tos/bssl/%.o: $(BSSL)/src/%.c
	@mkdir -p $(@D)
	$(M68KCC) -m68030 -msoft-float -O2 -fomit-frame-pointer -ffreestanding -fno-builtin -fno-pic -fno-pie \
		-fno-tree-loop-distribute-patterns -fno-asynchronous-unwind-tables -w -nostdinc -isystem $(GCCINC) \
		-Iatari/include -Icommon/atari/include -I$(BSSL)/inc -I$(BSSL)/src $(BSSL_DEF) -c $< -o $@
build/tos/libbearssl.a: $(patsubst $(BSSL)/src/%.c,build/tos/bssl/%.o,$(BSSL_SRC))
	rm -f $@
	$(CROSS)ar rcs $@ $^
build/tos/ewget.elf: $(tos_RT) build/tos/ewget/ewget.o build/tos/ewget/main_tos.o $(TOSNET_OBJ) \
		build/tos/libbearssl.a
	$(M68KCC) $(TOS_LDFLAGS) -o $@ $(filter %.o,$^) build/tos/libbearssl.a -lgcc
binary/EWGET.TTP: build/tos/ewget.elf common/tools/elf2tos.py
	@mkdir -p binary
	PRGFLAGS=7 python3 common/tools/elf2tos.py $< $@

# pictures (common/src/pic.c): JPEG with libjpeg-turbo (NetSurf's choice,
# 8-bit only: pic_lj8.c), PNG (png.c), GIF (NetSurf's libnsgif)
PIC_C    := pic png pic_lj8
LJ       := common/third_party/libjpeg-turbo
LJ_C     := jaricom jcomapi jdapimin jdapistd jdarith jdcoefct jdcolor jddctmgr jdhuff jdinput jdmainct \
            jdmarker jdmaster jdmerge jdphuff jdpostct jdsample jdtrans jidctfst jidctint jidctred jmemmgr \
            jmemnobs jquant1 jquant2 jutils
PIC_INC  := -DPIC_LIBJPEG -DNO_GETENV -DNO_PUTENV -DAERA_NO_FLOAT -I$(LJ)/src -I$(LJ)/config -Icommon/third_party/nsgif/include
TOSPIC_OBJ := $(addprefix build/tos/pic/,$(addsuffix .o,$(PIC_C) $(LJ_C) gif lzw))
build/tos/pic/%.o: common/src/%.c $(NET_HDRS)
	@mkdir -p $(@D)
	$(M68KCC) $(TOSNET_CFLAGS) $(PIC_INC) $(COMMON_WARN) -c $< -o $@
build/tos/pic/%.o: $(LJ)/src/%.c $(wildcard $(LJ)/src/*.h $(LJ)/config/*.h)
	@mkdir -p $(@D)
	$(M68KCC) $(TOSNET_CFLAGS) $(PIC_INC) -w -c $< -o $@
build/tos/pic/%.o: common/third_party/nsgif/src/%.c common/third_party/nsgif/include/nsgif.h
	@mkdir -p $(@D)
	$(M68KCC) $(TOSNET_CFLAGS) $(PIC_INC) -DNDEBUG -w -c $< -o $@
HOSTPIC_SRC := $(addprefix common/src/,$(addsuffix .c,$(PIC_C)))
HOSTPIC_3P  := $(addprefix $(LJ)/src/,$(addsuffix .c,$(LJ_C))) common/third_party/nsgif/src/gif.c \
               common/third_party/nsgif/src/lzw.c
HOSTPIC_INC  = -DPIC_LIBJPEG -DNO_GETENV -DNO_PUTENV -DAERA_NO_FLOAT $(addprefix -I$(CURDIR)/,common/src $(LJ)/src $(LJ)/config \
               common/third_party/nsgif/include)
build/host/pic.a: $(HOSTPIC_SRC) $(HOSTPIC_3P) $(NET_HDRS)
	@rm -rf build/host/pic && mkdir -p build/host/pic
	cd build/host/pic && $(HOSTCC) -O2 -g -std=gnu99 -Wall -Wno-sign-compare $(HOSTPIC_INC) \
		-c $(addprefix $(CURDIR)/,$(HOSTPIC_SRC))
	cd build/host/pic && $(HOSTCC) -O2 -g -std=gnu99 -DNDEBUG -w $(HOSTPIC_INC) -c $(addprefix $(CURDIR)/,$(HOSTPIC_3P))
	rm -f $@ && ar rcs $@ build/host/pic/*.o
build/asan/pic.a: $(HOSTPIC_SRC) $(HOSTPIC_3P) $(NET_HDRS)
	@rm -rf build/asan/pic && mkdir -p build/asan/pic
	cd build/asan/pic && $(HOSTCC) -O1 -g -std=gnu99 $(SAN) -Wall -Wno-sign-compare $(HOSTPIC_INC) \
		-c $(addprefix $(CURDIR)/,$(HOSTPIC_SRC))
	cd build/asan/pic && $(HOSTCC) -O1 -g -std=gnu99 $(SAN) -DNDEBUG -w $(HOSTPIC_INC) \
		-c $(addprefix $(CURDIR)/,$(HOSTPIC_3P))
	rm -f $@ && ar rcs $@ build/asan/pic/*.o

# JavaScript (src/js): QuickJS (third_party/quickjs, CONFIG_EWEB) on EWeb's
# document. On the Atari it is built for the FPU (-m68881: libgcc's
# soft-float doubles are PIC code, and JavaScript's numbers are all
# doubles) with musl's maths (third_party/libm) and the shims in
# atari/include/js; EWEB.PRG runs it only when there is an FPU. The ST
# edition and formtest have js_none.c.
QJS      := third_party/quickjs
QJS_C    := quickjs libregexp libunicode cutils dtoa
QJS_DEF  := -DCONFIG_EWEB -DCONFIG_VERSION=\"$(shell cat $(QJS)/VERSION)\"
QJS_HDRS := $(wildcard $(QJS)/*.h)
LIBM     := third_party/libm
LIBM_C   := $(basename $(notdir $(wildcard $(LIBM)/src/*.c)))
JS_FLAGS  = $(EWB_FLAGS) $(NSINC) -I$(QJS) $(QJS_DEF)
host_JS  := build/host/js/js.o $(addprefix build/host/qjs/,$(addsuffix .o,$(QJS_C)))
asan_JS  := build/asan/js/js.o $(addprefix build/asan/qjs/,$(addsuffix .o,$(QJS_C)))
build/host/qjs/%.o: $(QJS)/%.c $(QJS_HDRS)
	@mkdir -p $(@D)
	$(HOSTCC) -O2 -g -std=gnu99 -DNDEBUG $(QJS_DEF) -w -c $< -o $@
# (AddressSanitizer only: QuickJS's own shifts and casts aren't UBSan's
# business here; its assertions stay on, and find what EWeb leaks)
build/asan/qjs/%.o: $(QJS)/%.c $(QJS_HDRS)
	@mkdir -p $(@D)
	$(HOSTCC) -O1 -g -std=gnu99 -fsanitize=address -fno-omit-frame-pointer $(QJS_DEF) -w -c $< -o $@
build/host/js/js.o: src/js/js.c $(EWB_HDRS) $(QJS_HDRS)
	@mkdir -p $(@D)
	$(HOSTCC) -O2 -g -std=gnu99 $(JS_FLAGS) -c $< -o $@
build/asan/js/js.o: src/js/js.c $(EWB_HDRS) $(QJS_HDRS)
	@mkdir -p $(@D)
	$(HOSTCC) -O1 -g -std=gnu99 $(SAN) $(JS_FLAGS) -c $< -o $@
build/%/js/js_none.o: src/js/js_none.c src/js/js.h src/doc/doc.h
	@mkdir -p $(@D)
	$(HOSTCC) -O1 -g -std=gnu99 $(if $(filter asan,$*),$(SAN)) $(EWB_FLAGS) $(NSINC) -c $< -o $@

TOSJS_CFLAGS := -m68030 -m68881 -O2 -std=gnu99 -DNDEBUG -DEW_TOS -ffreestanding -fno-builtin -fno-pic -fno-pie \
                -fno-tree-loop-distribute-patterns -fno-asynchronous-unwind-tables -nostdinc -isystem $(GCCINC) \
                -U__linux__ -U__gnu_linux__ -U__GLIBC__ -Iatari/include/js -I$(LIBM)/eweb -Iatari/include \
                -Icommon/atari/include
tos_JS := build/tos/js/js.o build/tos/js/js_libc.o $(addprefix build/tos/qjs/,$(addsuffix .o,$(QJS_C))) \
          $(addprefix build/tos/libm/,$(addsuffix .o,$(LIBM_C) eweb_fpu))
build/tos/qjs/%.o: $(QJS)/%.c $(QJS_HDRS) $(wildcard atari/include/js/*.h atari/include/js/sys/*.h $(LIBM)/eweb/*.h)
	@mkdir -p $(@D)
	$(M68KCC) $(TOSJS_CFLAGS) $(QJS_DEF) -w -c $< -o $@
build/tos/libm/%.o: $(LIBM)/src/%.c $(wildcard $(LIBM)/src/*.h $(LIBM)/eweb/*.h)
	@mkdir -p $(@D)
	$(M68KCC) $(TOSJS_CFLAGS) -include features.h -I$(LIBM)/src -w -c $< -o $@
build/tos/libm/eweb_fpu.o: $(LIBM)/eweb/eweb_fpu.c
	@mkdir -p $(@D)
	$(M68KCC) $(TOSJS_CFLAGS) $(NET_WARN) -c $< -o $@
build/tos/js/js.o: src/js/js.c $(EWB_HDRS) $(QJS_HDRS) VERSION
	@mkdir -p $(@D)
	$(M68KCC) $(TOSJS_CFLAGS) $(JS_FLAGS) -c $< -o $@
build/tos/js/js_libc.o: atari/js_libc.c $(NET_HDRS) $(wildcard atari/include/js/*.h atari/include/js/sys/*.h)
	@mkdir -p $(@D)
	$(M68KCC) $(TOSJS_CFLAGS) $(NET_INC) $(NET_WARN) -c $< -o $@
build/st/js/js_none.o: src/js/js_none.c src/js/js.h src/doc/doc.h
	@mkdir -p $(@D)
	$(M68KCC) $(ST_CFLAGS) $(EWB_FLAGS) $(NSINC) -c $< -o $@

# EWEBJS.OVL: EWEB.PRG's JavaScript in a file of its own, loaded the first
# time a site's scripts run (atari/js_ovl.h; DESIGN.md, One EWEB.PRG for
# every Falcon). JS_ABI ties it to the EWEB.PRG made with it: the overlay
# reads EWeb's structures, so both are made from the same headers.
JS_ABI := $(shell cat VERSION $(sort $(EWB_HDRS)) atari/js_ovl.h | cksum | cut -d' ' -f1)UL
JS_OVL_HDRS = $(EWB_HDRS) atari/js_ovl.h VERSION
build/tos/js/js_ovl_head.o: atari/js_ovl_head.c $(JS_OVL_HDRS)
	@mkdir -p $(@D)
	$(M68KCC) $(TOSJS_CFLAGS) $(JS_FLAGS) -Iatari -DJS_ABI=$(JS_ABI) -c $< -o $@
build/tos/ewebjs.elf: build/tos/js/js_ovl_head.o $(tos_JS) atari/ovl.ld
	$(M68KCC) -m68030 -m68881 -nostdlib -static -no-pie -Wl,--emit-relocs -Wl,-T,atari/ovl.ld \
		-Wl,--build-id=none -Wl,-z,noexecstack -Wl,--no-warn-rwx-segments -Wl,--unresolved-symbols=ignore-all \
		-o $@ $(filter %.o,$^) -lgcc
binary/EWEBJS.OVL $(GEN)/js_imports.c &: build/tos/ewebjs.elf tools/mkovl.py common/tools/elf2tos.py
	@mkdir -p binary $(GEN)
	python3 tools/mkovl.py $< binary/EWEBJS.OVL $(GEN)/js_imports.c
build/tos/js/js_imports.o: $(GEN)/js_imports.c
	$(M68KCC) $(TOS_CFLAGS) -fno-builtin -c $< -o $@
build/tos/js/js_ovl.o: atari/js_ovl.c $(JS_OVL_HDRS)
	@mkdir -p $(@D)
	$(M68KCC) $(TOSNET_CFLAGS) $(EWB_INC) $(NSINC) $(NET_WARN) -DJS_ABI=$(JS_ABI) -c $< -o $@

