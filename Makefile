# fuzzing (the AERA guidelines, 7.1): what servers send, and the
# addresses in pages. Needs clang with libFuzzer; make fuzz runs each
# target FUZZTIME seconds from tests/fuzz/seeds (tests/fuzz/mkseeds.py) and
# what once broke them (tests/fuzz/found); make test runs those again
# without libFuzzer (common/tests/fuzz/replay.c)
FUZZCC    ?= clang
FUZZTIME  ?= 60
FUZZERS   := http url cookie disposition
FUZZ_SRC  = $(HOSTNET_SRC) common/tests/fuzz/fuzz_net.c
build/fuzz/fuzz_%: tests/fuzz/fuzz_%.c $(HOSTNET_SRC) $(NET_HDRS) build/host/libbearssl.a
	@mkdir -p $(@D)
	$(FUZZCC) -g -O1 -fsanitize=fuzzer,address,undefined -fno-sanitize-recover=undefined -DFUZZ_NET \
		$(NET_INC) -Icommon/tests/fuzz -o $@ $< $(FUZZ_SRC) build/host/libbearssl.a
build/asan/replay_%: tests/fuzz/fuzz_%.c common/tests/fuzz/replay.c $(HOSTNET_SRC) $(NET_HDRS) build/host/libbearssl.a
	@mkdir -p $(@D)
	$(HOSTCC) -O1 -g -std=gnu99 $(SAN) -fno-sanitize-recover=undefined -DFUZZ_NET $(NET_INC) -Icommon/tests/fuzz \
		-o $@ $< common/tests/fuzz/replay.c $(FUZZ_SRC) build/host/libbearssl.a
# the HTML parser: pages, with the charset, scripting and a fragment's
# context from the input's first byte
FUZZ_HTML_SRC = src/doc/doc.c src/doc/form.c src/doc/html.c src/doc/ua.c $(EC_SRC) $(PU_SRC)
FUZZ_HTML_INC = $(EWB_INC) -I$(GEN) $(NSDEF) $(NSINC) $(PU_INC)
build/fuzz/fuzz_html: tests/fuzz/fuzz_html.c $(FUZZ_HTML_SRC) $(EWB_HDRS) $(GEN)/entities.h $(GENERATED)
	@mkdir -p $(@D)
	$(FUZZCC) -g -O1 -fsanitize=fuzzer,address,undefined -fno-sanitize-recover=undefined -w \
		$(FUZZ_HTML_INC) -o $@ $< $(FUZZ_HTML_SRC)
build/asan/replay_html: tests/fuzz/fuzz_html.c common/tests/fuzz/replay.c $(FUZZ_HTML_SRC) $(EWB_HDRS) \
		$(GEN)/entities.h $(GENERATED)
	@mkdir -p $(@D)
	$(HOSTCC) -O1 -g -std=gnu99 $(SAN) -fno-sanitize-recover=undefined -w $(FUZZ_HTML_INC) \
		-o $@ $< common/tests/fuzz/replay.c $(FUZZ_HTML_SRC)
FUZZERS += html
# bookmark files (src/browse/bookmark.c)
FUZZ_BM_SRC = src/browse/bookmark.c common/src/util.c common/src/futil.c tests/host/plat_posix.c
build/fuzz/fuzz_bookmark: tests/fuzz/fuzz_bookmark.c $(FUZZ_BM_SRC) src/browse/bookmark.h
	@mkdir -p $(@D)
	$(FUZZCC) -g -O1 -fsanitize=fuzzer,address,undefined -fno-sanitize-recover=undefined -Isrc -Isrc/browse \
		-Icommon/src -o $@ $< $(FUZZ_BM_SRC)
build/asan/replay_bookmark: tests/fuzz/fuzz_bookmark.c common/tests/fuzz/replay.c $(FUZZ_BM_SRC) \
		src/browse/bookmark.h
	@mkdir -p $(@D)
	$(HOSTCC) -O1 -g -std=gnu99 $(SAN) -fno-sanitize-recover=undefined -Isrc -Isrc/browse -Icommon/src \
		-o $@ $< common/tests/fuzz/replay.c $(FUZZ_BM_SRC)
FUZZERS += bookmark

fuzz: $(addprefix build/fuzz/fuzz_,$(FUZZERS))
	@for f in $(FUZZERS); do \
	  mkdir -p build/fuzz/corpus/$$f; \
	  echo "fuzz_$$f: $(FUZZTIME) s"; \
	  build/fuzz/fuzz_$$f -max_total_time=$(FUZZTIME) -timeout=10 -rss_limit_mb=1024 \
	    -artifact_prefix=build/fuzz/crash-$$f- build/fuzz/corpus/$$f tests/fuzz/seeds/$$f \
	    $$(ls -d tests/fuzz/found/$$f 2>/dev/null) \
	    > build/fuzz/fuzz_$$f.log 2>&1 || { tail -40 build/fuzz/fuzz_$$f.log; exit 1; }; \
	  grep -E "^#[0-9]+.*DONE" build/fuzz/fuzz_$$f.log | tail -1; \
	done
.PHONY: fuzz

