# build output: programs are published on the Releases page, not committed
# (/build/ only at the top: NetSurf's libraries keep their generators in a
# build/ folder of their own)
/build/
binary/
dist/
*.o

# Python
__pycache__/
*.pyc
.venv/

# files the program writes when it runs (e.g. in a test run from binary/):
# settings may hold server names, the key file decrypts passwords
*.KEY
CRASH.LOG

# test rigs
tests/**/work/
*.log
common/tools/pens/build/
